{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageOneFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-tf"
    },
    {
      "Sid": "CreateOrUpdateIamUrlOnly",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig"
      ],
      "Resource": "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-tf",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "AWS_IAM"
        }
      }
    },
    {
      "Sid": "DeleteOwnUrl",
      "Effect": "Allow",
      "Action": [
        "lambda:DeleteFunctionUrlConfig"
      ],
      "Resource": "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-tf"
    },
    {
      "Sid": "ManageOneTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:UpdateTable",
        "dynamodb:DeleteTable",
        "dynamodb:TagResource",
        "dynamodb:UntagResource"
      ],
      "Resource": "arn:aws:dynamodb:ap-northeast-1:364561592630:table/nilab-content-tf"
    },
    {
      "Sid": "ManageOwnLogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:TagLogGroup",
        "logs:UntagLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:ap-northeast-1:364561592630:log-group:/aws/lambda/nilab-content-tf",
        "arn:aws:logs:ap-northeast-1:364561592630:log-group:/aws/lambda/nilab-content-tf:*"
      ]
    },
    {
      "Sid": "CreateBoundedRuntimeRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": "arn:aws:iam::364561592630:role/nilab-content-tf-runtime",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::364561592630:policy/nilab-content-tf-runtime-boundary"
        }
      }
    },
    {
      "Sid": "ManageRuntimeInlinePolicy",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::364561592630:role/nilab-content-tf-runtime",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::364561592630:policy/nilab-content-tf-runtime-boundary"
        }
      }
    },
    {
      "Sid": "ManageRuntimeRoleTagsAndLifecycle",
      "Effect": "Allow",
      "Action": [
        "iam:TagRole",
        "iam:UntagRole",
        "iam:DeleteRole"
      ],
      "Resource": "arn:aws:iam::364561592630:role/nilab-content-tf-runtime"
    },
    {
      "Sid": "PassOnlyRuntimeRoleToLambda",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::364561592630:role/nilab-content-tf-runtime",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "KeepRuntimeBoundary",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::364561592630:role/nilab-content-tf-runtime"
    },
    {
      "Sid": "ProtectBoundaryDefinition",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicy"
      ],
      "Resource": "arn:aws:iam::364561592630:policy/nilab-content-tf-runtime-boundary"
    },
    {
      "Sid": "InvokeIamUrl",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunctionUrl"
      ],
      "Resource": "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-tf",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "AWS_IAM"
        }
      }
    },
    {
      "Sid": "InvokeOnlyViaUrl",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-tf",
      "Condition": {
        "Bool": {
          "lambda:InvokedViaFunctionUrl": "true"
        }
      }
    }
  ]
}
