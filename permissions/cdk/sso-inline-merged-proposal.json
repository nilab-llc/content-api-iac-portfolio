{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ScopedRule01",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": [
        "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-tf",
        "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-cfn",
        "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-cdk"
      ]
    },
    {
      "Sid": "ScopedRule02",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig"
      ],
      "Resource": [
        "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-tf",
        "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-cfn",
        "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-cdk"
      ],
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "AWS_IAM"
        }
      }
    },
    {
      "Sid": "ScopedRule03",
      "Effect": "Allow",
      "Action": [
        "lambda:DeleteFunctionUrlConfig"
      ],
      "Resource": [
        "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-tf",
        "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-cfn",
        "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-cdk"
      ]
    },
    {
      "Sid": "ScopedRule04",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:UpdateTable",
        "dynamodb:DeleteTable",
        "dynamodb:TagResource",
        "dynamodb:UntagResource"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-northeast-1:364561592630:table/nilab-content-tf",
        "arn:aws:dynamodb:ap-northeast-1:364561592630:table/nilab-content-cfn",
        "arn:aws:dynamodb:ap-northeast-1:364561592630:table/nilab-content-cdk"
      ]
    },
    {
      "Sid": "ScopedRule05",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:TagLogGroup",
        "logs:UntagLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:ap-northeast-1:364561592630:log-group:/aws/lambda/nilab-content-tf",
        "arn:aws:logs:ap-northeast-1:364561592630:log-group:/aws/lambda/nilab-content-tf:*",
        "arn:aws:logs:ap-northeast-1:364561592630:log-group:/aws/lambda/nilab-content-cfn",
        "arn:aws:logs:ap-northeast-1:364561592630:log-group:/aws/lambda/nilab-content-cfn:*",
        "arn:aws:logs:ap-northeast-1:364561592630:log-group:/aws/lambda/nilab-content-cdk",
        "arn:aws:logs:ap-northeast-1:364561592630:log-group:/aws/lambda/nilab-content-cdk:*"
      ]
    },
    {
      "Sid": "ScopedRule06",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": [
        "arn:aws:iam::364561592630:role/nilab-content-tf-runtime"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::364561592630:policy/nilab-content-tf-runtime-boundary"
        }
      }
    },
    {
      "Sid": "ScopedRule07",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::364561592630:role/nilab-content-tf-runtime"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::364561592630:policy/nilab-content-tf-runtime-boundary"
        }
      }
    },
    {
      "Sid": "ScopedRule08",
      "Effect": "Allow",
      "Action": [
        "iam:TagRole",
        "iam:UntagRole",
        "iam:DeleteRole"
      ],
      "Resource": [
        "arn:aws:iam::364561592630:role/nilab-content-tf-runtime",
        "arn:aws:iam::364561592630:role/nilab-content-cfn-runtime",
        "arn:aws:iam::364561592630:role/nilab-content-cdk-runtime"
      ]
    },
    {
      "Sid": "ScopedRule09",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::364561592630:role/nilab-content-tf-runtime",
        "arn:aws:iam::364561592630:role/nilab-content-cfn-runtime",
        "arn:aws:iam::364561592630:role/nilab-content-cdk-runtime"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ScopedRule10",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary"
      ],
      "Resource": [
        "arn:aws:iam::364561592630:role/nilab-content-tf-runtime",
        "arn:aws:iam::364561592630:role/nilab-content-cfn-runtime",
        "arn:aws:iam::364561592630:role/nilab-content-cdk-runtime"
      ]
    },
    {
      "Sid": "ScopedRule11",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicy"
      ],
      "Resource": [
        "arn:aws:iam::364561592630:policy/nilab-content-tf-runtime-boundary",
        "arn:aws:iam::364561592630:policy/nilab-content-cfn-runtime-boundary",
        "arn:aws:iam::364561592630:policy/nilab-content-cdk-runtime-boundary"
      ]
    },
    {
      "Sid": "ScopedRule12",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunctionUrl"
      ],
      "Resource": [
        "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-tf",
        "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-cfn",
        "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-cdk"
      ],
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "AWS_IAM"
        }
      }
    },
    {
      "Sid": "ScopedRule13",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-tf",
        "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-cfn",
        "arn:aws:lambda:ap-northeast-1:364561592630:function:nilab-content-cdk"
      ],
      "Condition": {
        "Bool": {
          "lambda:InvokedViaFunctionUrl": "true"
        }
      }
    },
    {
      "Sid": "ScopedRule14",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": [
        "arn:aws:iam::364561592630:role/nilab-content-cfn-runtime"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::364561592630:policy/nilab-content-cfn-runtime-boundary"
        }
      }
    },
    {
      "Sid": "ScopedRule15",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::364561592630:role/nilab-content-cfn-runtime"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::364561592630:policy/nilab-content-cfn-runtime-boundary"
        }
      }
    },
    {
      "Sid": "ScopedRule16",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet"
      ],
      "Resource": [
        "arn:aws:cloudformation:ap-northeast-1:364561592630:stack/nilab-content-cfn/*",
        "arn:aws:cloudformation:ap-northeast-1:364561592630:changeSet/nilab-content-cfn-*/*",
        "arn:aws:cloudformation:ap-northeast-1:364561592630:stack/nilab-content-cdk/*",
        "arn:aws:cloudformation:ap-northeast-1:364561592630:changeSet/nilab-content-cdk-*/*"
      ],
      "Condition": {
        "Null": {
          "cloudformation:RoleArn": "true"
        }
      }
    },
    {
      "Sid": "ScopedRule17",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet"
      ],
      "Resource": [
        "arn:aws:cloudformation:ap-northeast-1:364561592630:stack/nilab-content-cfn/*",
        "arn:aws:cloudformation:ap-northeast-1:364561592630:changeSet/nilab-content-cfn-*/*",
        "arn:aws:cloudformation:ap-northeast-1:364561592630:stack/nilab-content-cdk/*",
        "arn:aws:cloudformation:ap-northeast-1:364561592630:changeSet/nilab-content-cdk-*/*"
      ]
    },
    {
      "Sid": "ScopedRule18",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:ListChangeSets",
        "cloudformation:DeleteStack",
        "cloudformation:ContinueUpdateRollback"
      ],
      "Resource": [
        "arn:aws:cloudformation:ap-northeast-1:364561592630:stack/nilab-content-cfn/*",
        "arn:aws:cloudformation:ap-northeast-1:364561592630:stack/nilab-content-cdk/*"
      ]
    },
    {
      "Sid": "ScopedRule19",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "ScopedRule20",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": [
        "arn:aws:iam::364561592630:role/nilab-content-cdk-runtime"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::364561592630:policy/nilab-content-cdk-runtime-boundary"
        }
      }
    },
    {
      "Sid": "ScopedRule21",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::364561592630:role/nilab-content-cdk-runtime"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::364561592630:policy/nilab-content-cdk-runtime-boundary"
        }
      }
    }
  ]
}
