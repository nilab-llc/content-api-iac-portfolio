{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ArticlesOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-northeast-1:364561592630:table/nilab-content-cfn"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-northeast-1:364561592630:log-group:/aws/lambda/nilab-content-cfn:*"
    }
  ]
}
